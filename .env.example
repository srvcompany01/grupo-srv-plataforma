# Produção (Vercel)
DATABASE_URL=postgresql://...            # Neon (preenchido pela integração)
ADMIN_SENHA=                             # senha do painel /admin
SESSAO_SEGREDO=                          # openssl rand -base64 48
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=srv-conteudo
NEXT_PUBLIC_URL_BASE=https://conteudo.gruposrv.com.br

# Desenvolvimento local sem Neon/R2 (nunca em produção)
# DATABASE_URL=pglite:./.dados/banco
# ARMAZENAMENTO_LOCAL=1

# Supabase (plataforma)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Só para npm run db:push (connection string do Session pooler) e npm run tipos
SUPABASE_DB_URL=
SUPABASE_PROJECT_ID=

# Busca de fotos para a capa dos clientes (https://unsplash.com/developers)
UNSPLASH_ACCESS_KEY=

# Google Agenda (OAuth "Aplicativo da Web" no Google Cloud, com a Google Calendar API ativada).
# URI de redirecionamento autorizado: https://<domínio da plataforma>/api/google/retorno
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anúncios do Meta (API de Marketing): token de um USUÁRIO DO SISTEMA do Gerenciador de Negócios com ads_read,
# com as contas de anúncios dos clientes atribuídas a ele. Só no servidor.
META_ACCESS_TOKEN=
# META_API_VERSION=v23.0
