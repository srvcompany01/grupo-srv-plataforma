{
  "name": "grupo-srv-conteudo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "db:push": "[ -n \"$SUPABASE_DB_URL\" ] || { set -a; . ./.env.local; set +a; } && supabase db push --db-url \"$SUPABASE_DB_URL\" --yes",
    "tipos": "[ -n \"$SUPABASE_PROJECT_ID\" ] || { set -a; . ./.env.local; set +a; }; supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" --schema public > src/infra/supabase/tipos.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.3",
    "fractional-indexing": "^4.0.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "supabase": "^2.120.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
